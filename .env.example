# Private values the tests compare the manifests with. Copy to .env (ignored by
# Git) and fill in; tests that need a missing value are skipped.
DOMAIN=                 # the public domain; hosts live under home.<DOMAIN>
HOMELAB_IP=             # LAN address of the control plane node
HOMELAB2_IP=            # LAN address of the worker node
PI_IP=                  # LAN address of the Raspberry Pi
NAS_IP=                 # LAN address of the TrueNAS host
CAMERA_IP=              # LAN address of the camera
ROUTER_DNAT_IP=         # router address that forwards to the camera
IOT_SUBNET=             # IoT network, CIDR
TAILSCALE_HOMELAB_IP=   # Tailscale address of the control plane node
TAILSCALE_HOMELAB2_IP=  # Tailscale address of the worker node
TAILSCALE_PI_IP=        # Tailscale address of the Raspberry Pi
NAS_POOL=               # ZFS pool mount point on the NAS, e.g. /mnt/<pool>
GITHUB_USER=            # the GitHub account allowed through oauth2-proxy
JENKINS_HOME_PV=        # PersistentVolume name of the Jenkins home
